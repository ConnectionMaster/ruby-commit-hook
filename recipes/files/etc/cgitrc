#
# cgit config
# see cgitrc(5) for details

css=/cgit-css/cgit.css
logo=/cgit-css/ruby.png
root-title=The Ruby Language git repositories

# Anonymous browsing is all cgit serves, so every rendered page is cacheable.
# 1000 entries were exhausted by scrapers walking distinct commits; the URLs
# carrying a SHA now redirect to GitHub, which leaves a working set small
# enough for the cache to actually hit. Snapshots stay off (no "snapshots="
# line), so tar/zip generation is never a load source.
cache-size=10000
branch-sort=age
enable-index-owner=0
virtual-root=/
enable-http-clone=1

repo.url=ruby.git
repo.path=/var/git/ruby.git
repo.desc=The Ruby Programming Language
