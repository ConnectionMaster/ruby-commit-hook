# Environment for anubis@cgit.service. Secrets are not here: the signing key
# lives in /etc/anubis/cgit.secret.env, which recipes/anubis.rb generates on
# the host and the systemd drop-in pulls in.

BIND=127.0.0.1:8923
BIND_NETWORK=tcp

# The Apache vhost that actually runs cgit.
TARGET=http://127.0.0.1:3001

POLICY_FNAME=/etc/anubis/cgit.botPolicies.yaml

METRICS_BIND=127.0.0.1:9090
METRICS_BIND_NETWORK=tcp

DIFFICULTY=4
COOKIE_DOMAIN=git.ruby-lang.org
COOKIE_EXPIRATION_TIME=168h

# Apache serves the real robots.txt, so Anubis must not shadow it.
SERVE_ROBOTS_TXT=0

SLOG_LEVEL=INFO
WEBMASTER_EMAIL=webmaster@ruby-lang.org
